<!DOCTYPE html>

<html lang="en">
  <% page_title = content_for(:title) || "Parksurf - aggregated UK parkrun results & analysis" %>
  <% page_description = content_for(:description) || \
    "aggregates age & gender grouped parkrun results across 800+ venues in the UK. Provides insights, trends, age and course records, friends achievements and MP leaderboard." %>
  <head>
    <title><%= page_title %></title>
    <meta name="description" content="<%= page_description %>">    
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Parksurf">
    <meta name="mobile-web-app-capable" content="yes">
    <!-- avoids Google treating url + query parameters as separate domain -->
    <link rel="canonical" href="https://parksurf.co.uk<%= request.path %>">    
    <%= render 'layouts/opengraph', { page_title: page_title, page_description: page_description } %>
    <%= render 'layouts/structured_data' %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

     <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= render 'layouts/favicon' %>
    <%= render 'layouts/posthog' unless Rails.env.development? %>
  </head>

  <body>
    <div id='flash' class="flash">  
      <%= render "layouts/flash" %>
    </div>    
    <%= yield %>
  </body>
</html>
