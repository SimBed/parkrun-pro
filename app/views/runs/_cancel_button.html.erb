<div class="d-flex flex-row-reverse p-1">
  <%= form_with url: @cancel_button_path,
                method: :get,
                data: { turbo_frame: @venue.parameterize } do %>
    <%= hidden_field_tag :variant, @variant %>                
    <button type="submit" class="border-0 bg-transparent">
      <i class="bi bi-x-circle"></i>
    </button>
  <% end %>

</div>

