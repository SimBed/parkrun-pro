<%= turbo_frame_tag venue_frame_id(@venue, @variant) do %>
  <div class="table-wrap table-wrap-runs <%= 'is-populated' if @referrer %>">
    <%= render 'cancel_button' if @cancel_button %>
    <%= render partial: 'runs/screensize/desktop' %>
    <%= render partial: 'runs/screensize/mobile' %>
    <%= render 'empty_table' if @runs.blank? %>
  </div>
<% end %>
