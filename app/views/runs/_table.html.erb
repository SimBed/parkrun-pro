<%= turbo_frame_tag 'table' do %>
  <div class="canvas gray100-canvas embossed px-md-2 py-2 mb-3">
    <%= tag.div class: class_names(
      "canvas gray100-canvas embossed col col-lg-6 col-xl-4 p-1 mb-2",
      "d-xl-none": !@show_pagy
      ) do %>
      <%= render 'pagination' if @show_pagy%>
      <%= render 'time_search' if @show_pagy%>
      <%= render 'sort_selection' %>
    <% end %>
    <%= render partial: 'table_content', locals: { venue: @venue, variant: @variant } %>
  </div>
<% end %>

<% if false %>
  <%# tring out class_names helper. Traditional approach below/ %>
 <div class= "<%= ['canvas', 'gray100-canvas', 'embossed', 'col', 'col-lg-6', 'col-xl-4', 'p-1', 'mb-2', ('d-xl-none' unless @show_pagy)].compact.join(' ') %>">
<%end%>
