<% content_for :title, "Venues" %>

<div class="container px-1 mt-2">
  <%= link_to new_venue_path, data: { turbo_frame: dom_id(Venue.new)}, alt: 'New Venue', class: 'btn btn-dark p-1' do %>
                              <i class="bi bi-plus-lg me-md-1"></i><span class="">Venue</span><% end %>
  <%= turbo_frame_tag Venue.new do %>
    <%= render 'empty_table' if @venues.empty? %>
  <% end %>

  <%= turbo_frame_tag 'venues' do %>
    <%= render 'table' unless @venues.empty? %>
  <% end %>
</div>