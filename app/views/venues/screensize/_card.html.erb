<div class="list-group-item py-1 border-0 border-bottom">

  <div class="d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-center gap-2">
      <span class="venues-name">
        <%= link_to venue.name, sanitize(venue.homepage), target: "_blank", rel: "noopener noreferrer" %>
      </span>
      <span class="venues-time">
        <%= venue.active? ? '&#9989;'.html_safe : '&#x274c;'.html_safe %>
      </span>
    </div>
  </div>

  <div class="text-muted small">
    <span class="mx-1">•</span>
    <span class="venues-agegroup"><%= venue.postcode %></span> 
  </div>

</div>