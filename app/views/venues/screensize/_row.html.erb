<tr>
  <td class="venues-name"><%= link_to venue.name, venue.homepage, target: "_blank", rel: "noopener noreferrer" %></td>
  <td class="venues-active"><%= venue.active? ? '&#9989;'.html_safe : '&#x274c;'.html_safe %></td>
  <td class="venues-postcode"><%= venue.postcode %></td>
  <td class="venues-address"><%= venue.address %></td>
  <td class="venues-edit"><%= link_to image_tag('edit.png', class: "table_icon"), edit_venue_path(venue), data: { turbo_frame: dom_id(venue) } %></td>
</tr>
<tr>
  <td colspan="5" class="p-0">
    <%= turbo_frame_tag venue %>  
  </td>
</tr>

  <%# used $brakeman -I to add config/brakeman.ignore file to mitigate the false positive 
  <%# Category: Cross-Site Scripting Check: LinkToHref Message: Potentially unsafe model attribute in link_to href
  <%# in respect of venue.homepage %>
  <%# https://brakemanscanner.org/docs/ignoring_false_positives/
   %>